# Obligatorio
TELEGRAM_TOKEN=tu_token_de_botfather
ODDS_API_KEY=tu_key_de_odds-api.net      # cuotas de Bet365 / Betano / Stake
API_FOOTBALL_KEY=tu_key_de_api-football  # historial: partidos, árbitros, estadísticas, bajas

# Opcional
ANTHROPIC_API_KEY=sk-ant-...             # activa /analisis (comentario con IA)
TELEGRAM_CHAT_ID=-100xxxxxxxxxx          # grupo donde mandar alertas automáticas
ALERTAS_MIN=0                            # cada cuántos minutos escanear (0 = apagado)
LIGAS_ALERTAS=                           # ej: Argentina Liga Profesional,Copa Libertadores
CASAS=bet365,betano,stake
DEPORTE=soccer

# Base histórica
LIGAS=128,71,13,39,140                   # IDs de API-Football: Argentina, Brasil A, Libertadores, Premier, LaLiga
SYNC_HORAS=12                            # cada cuántas horas actualizar la base
MAX_LLAMADAS=80                          # tope de consultas a API-Football por actualización
DB_PATH=                                 # por defecto agente-cuotas/datos.db

# Filtro de picks
EDGE_MIN=0.03                            # ventaja mínima contra el consenso de las casas
EDGE_MODELO=0.04                         # ventaja mínima según el modelo con historial
MIN_PARTIDOS=8                           # historial mínimo de cada equipo
MAX_DESVIO=0.15                          # si modelo y mercado difieren más, se descarta
ESCANEO_MAX=15                           # partidos revisados por escaneo
